# Nginx Configuration Example for protectapk.com
# Place this in /etc/nginx/sites-available/protectapk.com and link to sites-enabled

server {
    listen 80;
    server_name protectapk.com www.protectapk.com;

    # Redirect HTTP to HTTPS (optional but recommended)
    # return 301 https://$host$request_uri;

    root /var/www/protectapk.com/dist;
    index index.html;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # 1. API Endpoints - Proxy to Node.js Backend Server running on Port 3000
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }

    # 2. Static Assets Caching
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 3. SPA Frontend Routing
    location / {
        try_files $uri $uri/ /index.html;
    }
}
